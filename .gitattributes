# Line endings: store text as LF in the repo and check it out as LF on every
# machine, so Windows and Unix runners and parallel lanes never produce
# whitespace-only diffs. Git decides what is text; the lists below only
# settle the cases it could guess wrong.
* text=auto eol=lf

# Windows-only scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never convert, never diff as text.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.onnx binary
*.zip binary

